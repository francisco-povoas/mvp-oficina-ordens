ENVIRONMENT=dev
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://ordens:ordens@db:5432/ordens
JWT_SECRET_KEY=substitua-em-ambiente-seguro
JWT_ALGORITHM=HS256
JWT_ISSUER=mvp-oficina-ordens
JWT_USER_AUDIENCE=mvp-oficina-users
JWT_INTERNAL_TOKEN_EXPIRE_MINUTES=5
# JSON injetado por Secret; os hashes bcrypt e segredos reais não são versionados.
SERVICE_CLIENTS_JSON={}
INTERNAL_AUTH_URL=http://ordens:8000/internal/v1/auth/token
RESOURCES_BASE_URL=http://recursos:8000
FINANCE_BASE_URL=http://financeiro:8000
SERVICE_CLIENT_ID=mvp-oficina-ordens
SERVICE_CLIENT_SECRET=
INTERNAL_CONNECT_TIMEOUT_SECONDS=1.0
INTERNAL_READ_TIMEOUT_SECONDS=2.0

# Publisher independente da API. Em produção, omita SQS_ENDPOINT_URL e use IAM.
AWS_REGION=us-east-1
SQS_ENDPOINT_URL=http://elasticmq:9324
SQS_ORDENS_TO_RECURSOS_URL=http://elasticmq:9324/000000000000/mvp-oficina-ordens-to-recursos-local.fifo
SQS_RECURSOS_TO_ORDENS_URL=http://elasticmq:9324/000000000000/mvp-oficina-recursos-to-ordens-local.fifo
SQS_FINANCEIRO_TO_ORDENS_URL=http://elasticmq:9324/000000000000/mvp-oficina-financeiro-to-ordens-local.fifo
AWS_ACCESS_KEY_ID=local-only-elasticmq
AWS_SECRET_ACCESS_KEY=local-only-elasticmq
SQS_CONNECT_TIMEOUT_SECONDS=2
SQS_READ_TIMEOUT_SECONDS=25
SQS_SEND_TIMEOUT_SECONDS=5
PUBLISHER_BATCH_SIZE=10
PUBLISHER_LEASE_SECONDS=30
PUBLISHER_POLL_INTERVAL_SECONDS=1
PUBLISHER_MAX_ATTEMPTS=8
PUBLISHER_INITIAL_BACKOFF_SECONDS=1
PUBLISHER_MAX_BACKOFF_SECONDS=60
PUBLISHER_CONTRACT_SCHEMA_PATH=contracts/messages/saga-stock.v1.schema.json
CONSUMER_BATCH_SIZE=10
CONSUMER_CONCURRENCY=4
CONSUMER_WAIT_TIME_SECONDS=20
CONSUMER_VISIBILITY_TIMEOUT_SECONDS=60
CONSUMER_HEARTBEAT_SECONDS=20
RESOURCE_CONSUMER_SCHEMA_PATH=contracts/messages/saga-stock.v1.schema.json
FINANCIAL_CONSUMER_SCHEMA_PATH=contracts/vendor/financeiro/financial-events.v1.schema.json
