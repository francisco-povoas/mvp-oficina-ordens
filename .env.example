ENVIRONMENT=dev
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://ordens:ordens@db:5432/ordens
JWT_SECRET_KEY=substitua-em-ambiente-seguro
JWT_ALGORITHM=HS256
JWT_ISSUER=mvp-oficina-ordens
JWT_USER_AUDIENCE=mvp-oficina-users
JWT_INTERNAL_TOKEN_EXPIRE_MINUTES=5
# JSON injetado por Secret; os hashes bcrypt e segredos reais não são versionados.
SERVICE_CLIENTS_JSON={}
INTERNAL_AUTH_URL=http://ordens:8000/internal/v1/auth/token
RESOURCES_BASE_URL=http://recursos:8000
FINANCE_BASE_URL=http://financeiro:8000
SERVICE_CLIENT_ID=mvp-oficina-ordens
SERVICE_CLIENT_SECRET=
INTERNAL_CONNECT_TIMEOUT_SECONDS=1.0
INTERNAL_READ_TIMEOUT_SECONDS=2.0
