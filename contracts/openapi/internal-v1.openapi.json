{
  "openapi": "3.1.0",
  "info": {
    "title": "MVP Oficina Ordens — API interna",
    "version": "1.1.0",
    "description": "Contrato versionado das consultas REST funcionais da Etapa 2."
  },
  "servers": [{"url": "http://mvp-oficina-ordens/internal/v1"}],
  "paths": {
    "/auth/token": {
      "post": {
        "operationId": "issueServiceToken",
        "summary": "Emite JWT HS256 de serviço por client credentials",
        "parameters": [{"$ref": "#/components/parameters/CorrelationId"}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/ServiceTokenRequest"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token emitido",
            "headers": {"X-Correlation-ID": {"$ref": "#/components/headers/CorrelationId"}},
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ServiceTokenResponse"}
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "422": {"$ref": "#/components/responses/ValidationError"},
          "500": {"$ref": "#/components/responses/InternalError"}
        }
      }
    },
    "/orders/{order_id}/quote-context": {
      "get": {
        "operationId": "getQuoteContext",
        "x-implementation-status": "implemented-stage-2-rest",
        "x-required-scopes": ["orders:quote-context:read"],
        "security": [{"serviceBearer": []}],
        "parameters": [
          {"$ref": "#/components/parameters/OrderId"},
          {"$ref": "#/components/parameters/CorrelationId"}
        ],
        "responses": {
          "200": {
            "description": "Snapshot autoritativo para o orçamento",
            "headers": {"X-Correlation-ID": {"$ref": "#/components/headers/CorrelationId"}},
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/QuoteContext"}
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "422": {"$ref": "#/components/responses/ValidationError"},
          "500": {"$ref": "#/components/responses/InternalError"}
        }
      }
    },
    "/orders/{order_id}/payment-context": {
      "get": {
        "operationId": "getPaymentContext",
        "x-implementation-status": "implemented-stage-2-rest",
        "x-required-scopes": ["orders:payment-context:read"],
        "security": [{"serviceBearer": []}],
        "parameters": [
          {"$ref": "#/components/parameters/OrderId"},
          {"$ref": "#/components/parameters/ApprovedQuoteId"},
          {"$ref": "#/components/parameters/ApprovedQuoteVersion"},
          {"$ref": "#/components/parameters/ApprovedTotal"},
          {"$ref": "#/components/parameters/CorrelationId"}
        ],
        "responses": {
          "200": {
            "description": "Contexto autoritativo para registrar pagamento",
            "headers": {"X-Correlation-ID": {"$ref": "#/components/headers/CorrelationId"}},
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/PaymentContext"}
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "422": {"$ref": "#/components/responses/ValidationError"},
          "500": {"$ref": "#/components/responses/InternalError"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceBearer": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}
    },
    "parameters": {
      "OrderId": {
        "name": "order_id",
        "in": "path",
        "required": true,
        "schema": {"type": "string", "format": "uuid"}
      },
      "ApprovedQuoteId": {
        "name": "approved_quote_id",
        "in": "query",
        "required": true,
        "schema": {"type": "string", "format": "uuid"}
      },
      "ApprovedQuoteVersion": {
        "name": "approved_quote_version",
        "in": "query",
        "required": true,
        "schema": {"type": "integer", "minimum": 1}
      },
      "ApprovedTotal": {
        "name": "approved_total",
        "in": "query",
        "required": true,
        "schema": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{2})$"}
      },
      "CorrelationId": {
        "name": "X-Correlation-ID",
        "in": "header",
        "required": true,
        "schema": {"type": "string", "format": "uuid"}
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "A mesma chave e payload retornam o mesmo resultado; payload diferente gera 409.",
        "schema": {"type": "string", "minLength": 8, "maxLength": 128}
      }
    },
    "headers": {
      "CorrelationId": {"schema": {"type": "string", "format": "uuid"}}
    },
    "schemas": {
      "ServiceTokenRequest": {
        "type": "object",
        "required": ["grant_type", "client_id", "client_secret", "audience", "scope"],
        "properties": {
          "grant_type": {"const": "client_credentials"},
          "client_id": {"type": "string", "minLength": 1},
          "client_secret": {"type": "string", "minLength": 1, "writeOnly": true},
          "audience": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      },
      "ServiceTokenResponse": {
        "type": "object",
        "required": ["access_token", "token_type", "expires_in", "scope"],
        "properties": {
          "access_token": {"type": "string"},
          "token_type": {"const": "bearer"},
          "expires_in": {"type": "integer", "minimum": 1, "maximum": 300},
          "scope": {"type": "string"}
        },
        "additionalProperties": false
      },
      "SnapshotLine": {
        "type": "object",
        "required": ["reference_id", "description", "quantity", "unit_price"],
        "properties": {
          "reference_id": {"type": "string", "format": "uuid"},
          "description": {"type": "string"},
          "quantity": {"type": "integer", "minimum": 1},
          "unit_price": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{2})$"}
        },
        "additionalProperties": false
      },
      "QuoteContext": {
        "type": "object",
        "required": [
          "order_id", "order_version", "status", "customer_contact",
          "services", "items"
        ],
        "properties": {
          "order_id": {"type": "string", "format": "uuid"},
          "order_version": {"type": "integer", "minimum": 1},
          "status": {"const": "DIAGNOSTICO_CONCLUIDO"},
          "customer_contact": {
            "type": "object",
            "required": ["email", "telefone"],
            "properties": {
              "email": {"type": "string", "minLength": 1},
              "telefone": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "services": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/SnapshotLine"}
          },
          "items": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/SnapshotLine"}
          }
        },
        "additionalProperties": false
      },
      "PaymentContext": {
        "type": "object",
        "required": [
          "order_id", "order_version", "status", "approved_quote_id",
          "approved_quote_version", "approved_total"
        ],
        "properties": {
          "order_id": {"type": "string", "format": "uuid"},
          "order_version": {"type": "integer", "minimum": 1},
          "status": {"const": "FINALIZADA"},
          "approved_quote_id": {"type": "string", "format": "uuid"},
          "approved_quote_version": {"type": "integer", "minimum": 1},
          "approved_total": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{2})$"}
        },
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "required": ["code", "message", "correlation_id"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "message": {"type": "string", "minLength": 1, "maxLength": 512},
          "correlation_id": {"type": "string", "format": "uuid"},
          "operation_id": {
            "oneOf": [
              {"type": "string", "format": "uuid"},
              {"type": "null"}
            ]
          },
          "details": {"type": "object", "additionalProperties": true}
        },
        "additionalProperties": false
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Token ausente, inválido, expirado, de tipo incorreto ou para outra audiência",
        "headers": {"X-Correlation-ID": {"$ref": "#/components/headers/CorrelationId"}},
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}
      },
      "Forbidden": {
        "description": "Credencial válida sem o escopo exigido",
        "headers": {"X-Correlation-ID": {"$ref": "#/components/headers/CorrelationId"}},
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}
      },
      "NotFound": {
        "description": "Ordem não encontrada",
        "headers": {"X-Correlation-ID": {"$ref": "#/components/headers/CorrelationId"}},
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}
      },
      "Conflict": {
        "description": "Estado, versão ou idempotência incompatível",
        "headers": {"X-Correlation-ID": {"$ref": "#/components/headers/CorrelationId"}},
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}
      },
      "ValidationError": {
        "description": "Header, parâmetro ou corpo da requisição inválido",
        "headers": {"X-Correlation-ID": {"$ref": "#/components/headers/CorrelationId"}},
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}
      },
      "InternalError": {
        "description": "Falha interna sem exposição de detalhes sensíveis",
        "headers": {"X-Correlation-ID": {"$ref": "#/components/headers/CorrelationId"}},
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}
      },
      "Planned": {
        "description": "Contrato materializado; integração funcional pertence à Etapa 2",
        "headers": {"X-Correlation-ID": {"$ref": "#/components/headers/CorrelationId"}},
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}
      }
    }
  }
}

