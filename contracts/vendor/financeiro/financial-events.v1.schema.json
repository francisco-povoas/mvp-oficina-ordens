{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mvp-oficina/contracts/messages/financial-events.v1.schema.json",
  "title": "Eventos financeiros v1",
  "oneOf": [
    {"$ref": "#/$defs/QuoteCommunicated"},
    {"$ref": "#/$defs/QuoteApproved"},
    {"$ref": "#/$defs/QuoteRejected"},
    {"$ref": "#/$defs/PaymentConfirmed"}
  ],
  "$defs": {
    "Uuid": {"type": "string", "format": "uuid"},
    "Timestamp": {"type": "string", "format": "date-time"},
    "Money": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{2})$"},
    "Envelope": {
      "type": "object",
      "required": [
        "message_id", "message_type", "message_version", "occurred_at",
        "correlation_id", "causation_id", "operation_id", "saga_id", "payload"
      ],
      "properties": {
        "message_id": {"$ref": "#/$defs/Uuid"},
        "message_type": {"type": "string"},
        "message_version": {"const": 1},
        "occurred_at": {"$ref": "#/$defs/Timestamp"},
        "correlation_id": {"$ref": "#/$defs/Uuid"},
        "causation_id": {
          "oneOf": [{"$ref": "#/$defs/Uuid"}, {"type": "null"}]
        },
        "operation_id": {"$ref": "#/$defs/Uuid"},
        "saga_id": {"type": "null"},
        "payload": {"type": "object"}
      },
      "additionalProperties": false
    },
    "QuoteCommunicated": {
      "allOf": [
        {"$ref": "#/$defs/Envelope"},
        {
          "properties": {
            "message_type": {"const": "QuoteCommunicated"},
            "payload": {
              "type": "object",
              "required": [
                "order_id", "quote_id", "quote_version", "total", "communicated_at"
              ],
              "properties": {
                "order_id": {"$ref": "#/$defs/Uuid"},
                "quote_id": {"$ref": "#/$defs/Uuid"},
                "quote_version": {"type": "integer", "minimum": 1},
                "total": {"$ref": "#/$defs/Money"},
                "communicated_at": {"$ref": "#/$defs/Timestamp"}
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "QuoteApproved": {
      "allOf": [
        {"$ref": "#/$defs/Envelope"},
        {
          "properties": {
            "message_type": {"const": "QuoteApproved"},
            "payload": {
              "type": "object",
              "required": ["order_id", "quote_id", "quote_version", "approved_at"],
              "properties": {
                "order_id": {"$ref": "#/$defs/Uuid"},
                "quote_id": {"$ref": "#/$defs/Uuid"},
                "quote_version": {"type": "integer", "minimum": 1},
                "approved_at": {"$ref": "#/$defs/Timestamp"}
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "QuoteRejected": {
      "allOf": [
        {"$ref": "#/$defs/Envelope"},
        {
          "properties": {
            "message_type": {"const": "QuoteRejected"},
            "payload": {
              "type": "object",
              "required": [
                "order_id", "quote_id", "quote_version", "reason", "rejected_at"
              ],
              "properties": {
                "order_id": {"$ref": "#/$defs/Uuid"},
                "quote_id": {"$ref": "#/$defs/Uuid"},
                "quote_version": {"type": "integer", "minimum": 1},
                "reason": {"type": ["string", "null"], "maxLength": 512},
                "rejected_at": {"$ref": "#/$defs/Timestamp"}
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "PaymentConfirmed": {
      "allOf": [
        {"$ref": "#/$defs/Envelope"},
        {
          "properties": {
            "message_type": {"const": "PaymentConfirmed"},
            "payload": {
              "type": "object",
              "required": [
                "order_id", "quote_id", "quote_version", "payment_id",
                "status", "amount", "confirmed_at"
              ],
              "properties": {
                "order_id": {"$ref": "#/$defs/Uuid"},
                "quote_id": {"$ref": "#/$defs/Uuid"},
                "quote_version": {"type": "integer", "minimum": 1},
                "payment_id": {"$ref": "#/$defs/Uuid"},
                "status": {"const": "CONFIRMED"},
                "amount": {"$ref": "#/$defs/Money"},
                "confirmed_at": {"$ref": "#/$defs/Timestamp"}
              },
              "additionalProperties": false
            }
          }
        }
      ]
    }
  }
}

